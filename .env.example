# Origin verification (required together; store real values outside Git)
CF_MCP_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_MCP_ACCESS_AUDIENCE=replace-with-access-audience
CF_MCP_ALLOWED_EMAILS=owner@example.com
CF_MCP_PUBLIC_HOST=mcp.example.com

# Provisioning CLI (runtime shell only; never commit a real token)
CLOUDFLARE_API_TOKEN=replace-at-runtime
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_ACCESS_APPLICATION_ID=replace-with-application-id

